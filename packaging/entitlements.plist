<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for embedded V8 / Node.js runtime and WebKit JIT inside hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Loopback HTTP IPC between SwiftUI WKWebView shell and bundled Node.js engine -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- User-selected files via NSOpenPanel and drag-and-drop -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
